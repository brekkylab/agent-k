# API Keys (at least one required for agent execution)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=

# Web search for the deep-research agent
BRAVE_SEARCH_API_KEY=

# Backend
BIND_ADDR=127.0.0.1:8080
LOG_LEVEL=info,sqlx=warn

# Google OAuth app for the Gmail source (mount codes are exchanged server-side).
# Consent: access_type=offline + prompt=consent, scope gmail.readonly or
# gmail.modify (enables rm→Trash) — never gmail.metadata (403s q=/format=full).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live tests only; the backend doesn't read it.
GOOGLE_REFRESH_TOKEN=
# One host fronting every Google service, laid out the way Google's own paths read:
# {host}/gmail serves gmail/v1, {host}/oauth2 serves the token endpoint. Each service
# keeps the version suffix the official API uses, so nothing here encodes one mock's
# layout. Deployment config only — never user input, since the token endpoint receives
# the client secret.
# Default (unset): https://gmail.googleapis.com + https://oauth2.googleapis.com
# GOOGLE_API_BASE_URL=

# Slack app for the Slack source mount (mount codes are exchanged server-side).
# Request these as USER scopes, so the mount reads as the installing user — a
# workspace is one person's space, so what belongs in it is the Slack they see:
#   channels:history channels:read  groups:history groups:read
#   im:history im:read  mpim:history mpim:read
#   users:read  files:read  search:read
# users:read.email is NOT needed: users/*.json serves an allowlist of identity
# fields and no contact details, so an email would be fetched and discarded.
# Bot scopes are not needed (a bot sees only its own channels, no DMs, no search).
# Do NOT enable token rotation: the client holds no refresh loop, and Slack does
# not let an app turn rotation back off — a rotated token then dies every 12h.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Live tests only; the backend doesn't read these. Prefer the user token —
# a bot token exercises less (no DMs, no search). Against a mock origin, use a
# token that mock accepts rather than a real xoxp-/xoxb- one.
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
# Reroute all Slack calls to a mock/gateway ({base}/slack/api).
# Deployment config only — never user input: the token exchange sends the client
# secret, so the host it reaches must come from config, not from a request.
# Default (unset): https://slack.com/api
# SLACK_API_BASE_URL=
# The mount's own tests read the same override under a different name, because the
# workspace crate has no backend config to take it from. Set this one to run the
# slack_mock tests; a mock has no oauth.v2.access, so the mount-create code
# exchange is only exercisable against real Slack.
# SLACK_BASE_URL=

# Auth — set this in any deployment; missing value falls back to an insecure default + WARN log.
# Recommend 32+ random chars.
AGENT_K_JWT_SECRET=
# JWT lifetime in seconds (default: 604800 = 7 days)
# JWT_EXPIRY_SECONDS=604800

# Data
# Override to point at a different SQLite DB or directory.
# DATABASE_URL=sqlite://./data/agent-k.db
# AGENT_K_DATA_ROOT=./data
# Upload size limit in bytes (default: 52428800 = 50 MiB)
# AGENT_K_MAX_UPLOAD_BYTES=52428800

# Automation workers — number of tokio worker tasks spawned at boot (default: 2).
# Use 1 for cleaner logs during local debugging.
# AGENT_K_WORKER_COUNT=2

# Default IANA timezone for cron trigger specs that omit `tz`. Invalid or
# unset values fall back to "UTC".
# AGENT_K_DEFAULT_TZ=UTC
