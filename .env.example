# API Keys (at least one required for agent execution)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=

# Web search for the deep-research agent
BRAVE_SEARCH_API_KEY=

# Backend
BIND_ADDR=127.0.0.1:8080
LOG_LEVEL=info,sqlx=warn

# Google OAuth app for the Gmail source (mount codes are exchanged server-side).
# Consent: access_type=offline + prompt=consent, scope gmail.readonly or
# gmail.modify (enables rm→Trash) — never gmail.metadata (403s q=/format=full).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live tests only; the backend doesn't read it.
GOOGLE_REFRESH_TOKEN=
# One host fronting every Google service, laid out the way Google's own paths read:
# {host}/gmail serves gmail/v1, {host}/oauth2 serves the token endpoint. Each service
# keeps the version suffix the official API uses, so nothing here encodes one mock's
# layout. Deployment config only — never user input, since the token endpoint receives
# the client secret.
# Default (unset): https://gmail.googleapis.com + https://oauth2.googleapis.com
# GOOGLE_API_BASE_URL=

# GitHub source — live tests only; the backend doesn't read these. A real mount takes its
# tokens per mount through the API (one per owner), so none of it is deployment config.
#   cargo test -p workspace github_live -- --ignored --nocapture
# Token: fine-grained, `Contents: read-only`; add `Issues`/`Pull requests` read for those
# views. An org-owned repo needs the org to approve the token, and reads as 404 until then.
GITHUB_TOKEN=
GITHUB_OWNER=
# Serve only this repo. Unset = every repo the token reaches under the owner.
# GITHUB_REPO=
# Branch or commit SHA. Requires GITHUB_REPO — one ref can't describe a set of repos.
# GITHUB_REF=
# Ceiling on the issues/, pulls/ and repository listings (default: 200).
# GITHUB_INDEX_CAP=200

# Auth — set this in any deployment; missing value falls back to an insecure default + WARN log.
# Recommend 32+ random chars.
AGENT_K_JWT_SECRET=
# JWT lifetime in seconds (default: 604800 = 7 days)
# JWT_EXPIRY_SECONDS=604800

# Data
# Override to point at a different SQLite DB or directory.
# DATABASE_URL=sqlite://./data/agent-k.db
# AGENT_K_DATA_ROOT=./data
# Upload size limit in bytes (default: 52428800 = 50 MiB)
# AGENT_K_MAX_UPLOAD_BYTES=52428800

# Automation workers — number of tokio worker tasks spawned at boot (default: 2).
# Use 1 for cleaner logs during local debugging.
# AGENT_K_WORKER_COUNT=2

# Default IANA timezone for cron trigger specs that omit `tz`. Invalid or
# unset values fall back to "UTC".
# AGENT_K_DEFAULT_TZ=UTC
